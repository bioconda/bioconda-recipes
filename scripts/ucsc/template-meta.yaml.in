{{% set package = "{package}" %}}
{{% set program = "{program}" %}}
{{% set version = "{version}" %}}

package:
  name: "{{{{ package }}}}"
  version: "{{{{ version }}}}"

source:
  # GitHub, not hgdownload (the macOS builders reject hgdownload's certificate). A tag archive
  # carries no submodules, so htslib and its htscodecs come in at the commits the tag pins.
  - url: "https://github.com/ucscGenomeBrowser/kent/archive/refs/tags/v{{{{ version }}}}_base.tar.gz"
    sha256: "{kent_sha256}"
    folder: kent
    patches:
      - 0001-include.patch
      - 0003-common.mk.patch
      - 0004-straw.patch
  - url: "https://github.com/ucscGenomeBrowser/htslib/archive/{htslib_commit}.tar.gz"
    sha256: "{htslib_sha256}"
    folder: kent/src/submodules/htslib
  - url: "https://github.com/samtools/htscodecs/archive/{htscodecs_commit}.tar.gz"
    sha256: "{htscodecs_sha256}"
    folder: kent/src/submodules/htslib/htscodecs

build:
  number: 0
  run_exports:
    - {{{{ pin_subpackage(package, max_pin=None) }}}}

requirements:
  build:
    - make
    - {{{{ compiler('c') }}}}
    - {{{{ stdlib('c') }}}}
    - {{{{ compiler('cxx') }}}}
  host:
    - libpng
    - libuuid
    - mysql-connector-c # [not arm64]
    - mariadb-connector-c  # [arm64]
    - openssl
    - clangdev  # [osx]
    - libiconv
    - bzip2
    - liblzma-devel
    - zlib
    - libcurl
  run:
    # gzip called via fork so runtime only
    - gzip
    - libpng
    - libuuid
    - mysql-connector-c # [not arm64]
    - mariadb-connector-c  # [arm64]

test:
  commands:
    # just check for existence and exec bit, because the individual packages have no unified behavior
    - test -x ${{PREFIX}}/bin/{{{{ program }}}}

about:
  home: "https://hgdownload.soe.ucsc.edu/admin/exe"
  license: "Varies; see https://genome.ucsc.edu/license"
  summary: "{summary}"
  dev_url: "https://github.com/ucscGenomeBrowser/kent"
  doc_url: "https://github.com/ucscGenomeBrowser/kent/blob/v{{{{ version }}}}_base/README"

extra:
  identifiers:
    - biotools:UCSC_Genome_Browser_Utilities
    - doi:10.1093/bib/bbs038
  {linux_aarch64}