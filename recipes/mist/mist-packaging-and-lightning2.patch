MIST 2.0.0 patches for the bioconda recipe. Not submitted upstream.

# 1/2  setup.cfg: set version and license; find_namespace: so src/mist is packaged

--- a/setup.cfg
+++ b/setup.cfg
@@ -1,15 +1,15 @@
 [metadata]
 name = mist
-version = <version number: 0.0.1
-#license = <license name, e.g. MIT>
+version = 2.0.0
+license = MIT
 description = Metabolite Inference with Spectrum Transformers
 long_description = file: README.md
 author = Samuel Goldman
 #author_email = 
 classifiers=
 
 [options]
-packages = find:
+packages = find_namespace:
 package_dir =
     =src
 include_package_data = True

