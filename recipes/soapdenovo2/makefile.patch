 endif
 
diff --git a/fusion/Makefile b/fusion/Makefile
index 6b1159a..8fe575f 100755
--- a/fusion/Makefile
+++ b/fusion/Makefile
@@ -6,10 +6,10 @@ bindir = $(exec_prefix)/bin
 libdir = 
 mandir = 
 
-CC = gcc
-CCOPT = -O3 -fprefetch-loop-arrays -funroll-loops -fomit-frame-pointer -w 
-LIBS = -lm -lpthread
-INCDIRS = -Iinc/
+CC ?= $(CC)
+CCOPT = -O3 -fprefetch-loop-arrays -funroll-loops -fomit-frame-pointer -w -fcommon -Wno-implicit-function-declaration -std=gnu17 -fcommon -fpermissive
