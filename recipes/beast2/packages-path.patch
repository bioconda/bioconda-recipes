--- a/beast/bin/beast
+++ b/beast/bin/beast
@@ -23,6 +23,13 @@
 fi
 
 BEAST_LIB="$BEAST/lib"
+
+# Make the conda-bundled BEAST packages discoverable by the BEAST package
+# manager without writing to $HOME/.beast, which may be read-only in
+# containerised environments (e.g. Singularity, Galaxy). Any user-provided
+# paths are preserved.
+BEAST_PACKAGE_PATH="$BEAST/packages${BEAST_PACKAGE_PATH:+:$BEAST_PACKAGE_PATH}"
