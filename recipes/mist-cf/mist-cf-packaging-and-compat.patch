# 3/4  pandas 3: keep the spec column in the fast-filter top-k

--- a/src/mist_cf/fast_form_score/fast_form_model.py
+++ b/src/mist_cf/fast_form_score/fast_form_model.py
@@ -226,6 +226,7 @@
 
     # Subset to top k
     topk_fn = lambda x: x.nlargest(fast_num, ['scores'])
-    new_df = out_df.groupby(['spec']).apply(topk_fn).reset_index(drop=True)
+    groups = [topk_fn(group) for _, group in out_df.groupby(['spec'])]
+    new_df = (pd.concat(groups) if groups else out_df).reset_index(drop=True)
     return new_df
 

# 4/4  find sirius on PATH or in the environment when SIRIUS_PATH is unset

--- a/src/mist_cf/decomp/sirius_decomp.py
+++ b/src/mist_cf/decomp/sirius_decomp.py
@@ -14,10 +14,16 @@
 import pandas as pd
 import os
 import re
+import shutil
+import sys
 
 import mist_cf.common as common
 
-SIRIUS_LOC = Path(os.getenv("SIRIUS_PATH"))
+SIRIUS_LOC = Path(
+    os.getenv("SIRIUS_PATH")
+    or shutil.which("sirius")
