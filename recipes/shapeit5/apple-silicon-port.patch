+    while (nstored < (2 * depth_rare) && !done) {
+      done = 1;
+      if (h - offset >= 0) {
+        // if (N[h-offset].second/2 != target_hap/2) {
+        if (!checkIBD2(N[h - offset].second, target_hap)) {
