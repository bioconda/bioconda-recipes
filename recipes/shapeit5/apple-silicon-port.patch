+    float32x4_t _prob1 = vld1q_f32(&prob[i + 4]);
+    float32x4_t _a0 = vld1q_f32(&AlphaMissing[curr_rel_missing][i]);
+    float32x4_t _a1 = vld1q_f32(&AlphaMissing[curr_rel_missing][i + 4]);
