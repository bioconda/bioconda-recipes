--- a/Makefile
+++ b/Makefile
@@ -171,9 +171,10 @@ HISAT2_REPEAT_CPPS_MAIN = $(REPEAT_CPPS) $(BUILD_CPPS) hisat2_repeat_main.cpp
 SEARCH_FRAGMENTS = $(wildcard search_*_phase*.c)
 VERSION = $(shell cat VERSION)
 
+ARCH=$(shell uname -m)
 # Convert BITS=?? to a -m flag
 BITS=32
-ifeq (x86_64,$(shell uname -m))
+ifeq (x86_64,$(ARCH))
 BITS=64
 endif
 # ARM is 64-bit (aarch64/arm64) and does not take x86 -m32/-m64 flags; the ABI
@@ -189,12 +190,14 @@ ifneq (,$(findstring AMD64,$(PROCESSOR_ARCHITEW6432)))
 endif
 BITS_FLAG =
 
-ifeq (32,$(BITS))
-	BITS_FLAG = -m32
-endif
-
-ifeq (64,$(BITS))
-	BITS_FLAG = -m64
+ifeq (x86_64,$(ARCH))
+	ifeq (32,$(BITS))
+		BITS_FLAG = -m32
+	endif
+	ifeq (64,$(BITS))
+		BITS_FLAG = -m64
+	endif
+	SSE_FLAG=-msse2
 endif
 ifeq (1,$(ARM))
 	SSE_FLAG =
