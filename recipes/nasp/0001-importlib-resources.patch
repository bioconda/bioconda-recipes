From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: stubbyfowl <sidaksmann@gmail.com>
Date: Thu, 8 Oct 2026 21:22:51 -0700
Subject: [PATCH 1/3] fix: replace pkg_resources with importlib.resources

setuptools removed pkg_resources in 82.0.0 (81.0.0 is the last release
that ships it). NASP used pkg_resources.resource_filename() to locate
files bundled inside the package, so on any environment with a current
setuptools - or with no setuptools at all, which is the default for new
Python 3.12+ virtualenvs - these paths crash with
"ModuleNotFoundError: No module named 'pkg_resources'":

  - nasp/nasp.py gonasp_path(): every Go-backed subcommand
    (nasp matrix / export / duplicates / frankenfasta) and the
    MatrixGenerator step of a pipeline run
  - nasp/nasp.py _get_trimming_parameters(): the default adapter file
    offered when the user enables Trimmomatic
  - nasp/convert_external_genome.py main(): external-genome import

The released bioconda package only works today because its py38
environment happens to resolve setuptools 75.3.0.

All four call sites now use importlib.resources.files() (stdlib,
Python >= 3.9). NASP is installed as a regular directory package
(zip_safe=False), so the returned path is the real on-disk file, the
same path pkg_resources returned. python_requires='>=3.9' is declared so
pip refuses older interpreters up front instead of failing at runtime.

Refs: NASP bioconda diagnosis (FINDINGS.md), Attempts 04, 08 and 09,
Category 3 item 1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 nasp/convert_external_genome.py |  4 ++--
 nasp/nasp.py                    | 10 +++++-----
 setup.py                        |  1 +
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/nasp/convert_external_genome.py b/nasp/convert_external_genome.py
index 0ee0f2d..3b94a82 100755
--- a/nasp/convert_external_genome.py
+++ b/nasp/convert_external_genome.py
@@ -121,8 +121,8 @@ def main():
     #parse_delta_file(( external_nickname + ".filtered.delta" ), franken_genome, external_genome)
     #franken_genome.write_to_fasta_file(external_nickname + ".frankenfasta", "franken::")
 
-    import pkg_resources
-    nasptool_path = pkg_resources.resource_filename('nasp', 'nasptool_linux_64')
+    import importlib.resources
+    nasptool_path = str(importlib.resources.files('nasp').joinpath('nasptool_linux_64'))
     with open(external_nickname + ".frankenfasta", 'w') as handle:
         return_code = subprocess.call([nasptool_path, "frankenfasta", external_nickname + ".filtered.delta"], stdout=handle)
 
diff --git a/nasp/nasp.py b/nasp/nasp.py
index 8db34f4..991fdf5 100755
--- a/nasp/nasp.py
+++ b/nasp/nasp.py
@@ -364,9 +364,9 @@ def _get_job_submitter():
 
 
 def _get_trimming_parameters(queue, args):
-    import pkg_resources
+    import importlib.resources
     trim_path = _get_java_path("trimmomatic*.jar")
-    adapter_file = pkg_resources.resource_filename('nasp', 'illumina_adapters_all.fasta')
+    adapter_file = str(importlib.resources.files('nasp').joinpath('illumina_adapters_all.fasta'))
     quality_string = ''
     response = input("  What adapter file are you using for trimming [%s]? " % adapter_file)
     if response:
@@ -543,11 +543,11 @@ def _get_user_input(reference, output_folder):
 
 def gonasp_path():
     import sys
-    import pkg_resources
+    import importlib.resources
     if sys.maxsize > 2**32:
-        matrix_path = pkg_resources.resource_filename('nasp', 'nasptool_linux_64')
+        matrix_path = str(importlib.resources.files('nasp').joinpath('nasptool_linux_64'))
     else:
-        matrix_path = pkg_resources.resource_filename('nasp', 'nasptool_linux_32')
+        matrix_path = str(importlib.resources.files('nasp').joinpath('nasptool_linux_32'))
     if os.path.exists(matrix_path):
         return matrix_path
     else:
diff --git a/setup.py b/setup.py
index 72fcbae..df1f222 100755
--- a/setup.py
+++ b/setup.py
@@ -36,6 +36,7 @@ setup(
     },
     include_package_data=True,
     install_requires=requirements,
+    python_requires='>=3.9',
     license="Academic and Research License",
     zip_safe=False,
     keywords='nasp',
