   Real components[3] = {
-    std::abs<Real>(xyz[0]),
-    std::abs<Real>(xyz[1]),
-    std::abs<Real>(xyz[2])
+    std::abs(xyz[0]),
+    std::abs(xyz[1]),
+    std::abs(xyz[2])
   };
         
   Real*  where = ::std::min_element(components, components+3);
