-	fp = mm_bseq_open(fn);
-	if (fp == 0) return 0;
-	mi = mm_idx_gen(fp, w, k, 14, flag, 1<<18, n_threads, UINT64_MAX);
-	mm_bseq_close(fp);
-	return mi;
-}
